{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GitLab 학습 허브 배포",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/publish.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    }
  ]
}
